<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest_surface">

    <!-- Primary Vertical Content Structure Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_current_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ML_Datasets/"
            android:textColor="@color/forest_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Corrected Floating Action Delete Button Layer -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_delete_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:contentDescription="Delete Selected"
        android:src="@android:drawable/ic_menu_delete"
        android:visibility="gone"
        app:theme="@style/ThemeOverlay.MaterialComponents.Light"
        app:backgroundTint="@color/status_error"
        app:tint="@color/forest_border" />

</RelativeLayout>
